DB_VOLUME = /mnt/d/projects/FedServer/backend/app/storage
# DB_VOLUME=/backend/app/storage/database.db

# DB_VOLUME = D:/projects/FedClient/backend/app/storage   #(prashant)
# DB_VOLUME = /mnt/d/projects/FedClient/backend/app/storage   #(prashant wsl)

########################################################################

REACT_APP_SERVER_BASE_URL=http://localhost:8000
REACT_APP_PRIVATE_SERVER_BASE_URL=http://localhost:9090

DB_URL = "sqlite:///storage/database.db"

# Local dataset files (backend). In Docker, set LOCAL_STORAGE_DIR=/app/storage and mount a volume to /app/storage.
LOCAL_STORAGE_DIR=./storage
MERGE_TEMP_DIRECTORY=_merge_temp
RECENTLY_UPLOADED_DATASETS_DIR=uploads

# Optional: host path mounted to /app/storage in docker-compose (backend service)
# DATA_STORAGE_VOLUME=./storage

# S3 Related-
BUCKET_NAME =  "qpd-data"  
S3_PREFIX = "temp"  
S3_REGION = "ap-south-1"


####################################
# Checks:
# URLs of server and private server are set correctly
# LOCAL_STORAGE_DIR is writable by the backend
# QPD bucket details are set correctly
# confirm that DB file is present and at correct place 